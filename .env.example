# Database
DATABASE_URL=postgresql://user:password@db:5432/demowhatsapp

# Google APIs
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_CALENDAR_API_KEY=your-calendar-api-key

# Meta (WhatsApp Business API)
META_API_TOKEN=your-meta-api-token
META_BUSINESS_ACCOUNT_ID=your-business-account-id
META_PHONE_NUMBER_ID=your-phone-number-id
META_VERIFY_TOKEN=your-verify-token

# Firebird
FIREBIRD_HOST=firebird
FIREBIRD_PORT=3050
FIREBIRD_DATABASE=/firebird/data/demobot.fdb
FIREBIRD_USER=sysdba
FIREBIRD_PASSWORD=your-firebird-password

# EspoCRM
ESPOCRM_URL=https://espocrm.example.com
ESPOCRM_API_KEY=your-espocrm-api-key

# Gemini
GEMINI_API_KEY=your-gemini-api-key

# Lead Notifications
LEADS_EMAIL=team@example.com
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# Scheduler
LEAD_NOTIFICATION_HOUR=8
LEAD_NOTIFICATION_MINUTE=0

# Logging
LOG_LEVEL=INFO

# Deployment
ENVIRONMENT=development
DEBUG=false
