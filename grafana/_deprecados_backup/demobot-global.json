{
  "title": "DemoBot - Global Control Center",
  "description": "Robust technical and business command center for DemoBot global operations",
  "tags": ["demobot", "global", "operations", "infrastructure"],
  "timezone": "browser",
  "panels": [
    {
      "id": 1,
      "title": "Uptime del Agente",
      "type": "stat",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "demobot_uptime_seconds"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 0 }
    },
    {
      "id": 2,
      "title": "Salud de Dependencias",
      "type": "table",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "demobot_dependency_health"
        }
      ],
      "gridPos": { "h": 6, "w": 18, "x": 6, "y": 0 }
    },
    {
      "id": 3,
      "title": "Total Mensajes Procesados (Histórico)",
      "type": "stat",
      "datasource": "PostgreSQL",
      "targets": [
        {
          "rawSql": "SELECT count(*) as \"value\" FROM mensajes;",
          "format": "table"
        }
      ],
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 6 }
    },
    {
      "id": 4,
      "title": "Total Conversaciones (Histórico)",
      "type": "stat",
      "datasource": "PostgreSQL",
      "targets": [
        {
          "rawSql": "SELECT count(*) as \"value\" FROM conversaciones;",
          "format": "table"
        }
      ],
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 6 }
    },
    {
      "id": 5,
      "title": "Total Leads e Identificaciones Capturadas",
      "type": "stat",
      "datasource": "PostgreSQL",
      "targets": [
        {
          "rawSql": "SELECT count(*) as \"value\" FROM clientes WHERE tipo = 'lead';",
          "format": "table"
        }
      ],
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 6 }
    },
    {
      "id": 6,
      "title": "Total Casos Escalados a Humanos",
      "type": "stat",
      "datasource": "PostgreSQL",
      "targets": [
        {
          "rawSql": "SELECT count(*) as \"value\" FROM radicados;",
          "format": "table"
        }
      ],
      "gridPos": { "h": 6, "w": 6, "x": 18, "y": 6 }
    },
    {
      "id": 7,
      "title": "Rendimiento y Latencia de Peticiones API (P99)",
      "type": "timeseries",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "histogram_quantile(0.99, rate(http_request_duration_seconds_bucket[5m]))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth"
          },
          "unit": "s"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 }
    },
    {
      "id": 8,
      "title": "Errores Totales por Componente/Fallo",
      "type": "timeseries",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum by (error_type) (rate(demobot_errors_total[5m]))"
        }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 }
    },
    {
      "id": 9,
      "title": "Distribución Acumulada de Casos por Área",
      "type": "piechart",
      "datasource": "PostgreSQL",
      "targets": [
        {
          "rawSql": "SELECT count(*) as \"value\", a.nombre as \"metric\" FROM radicados r JOIN areas a ON r.area_id = a.id GROUP BY a.nombre;",
          "format": "table"
        }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 20 }
    },
    {
      "id": 10,
      "title": "Canales de Entrada de Clientes (Meta vs Telegram)",
      "type": "piechart",
      "datasource": "PostgreSQL",
      "targets": [
        {
          "rawSql": "SELECT count(*) as \"value\", canal as \"metric\" FROM contactos GROUP BY canal;",
          "format": "table"
        }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 20 }
    }
  ],
  "refresh": "10s",
  "version": 1,
  "time": {
    "from": "now-30d",
    "to": "now"
  }
}
