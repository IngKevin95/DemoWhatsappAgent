{
  "title": "DemoBot Soporte y Escalamientos",
  "description": "Salud del área de soporte: radicados, tiempos de resolución/espera, carga por agente y sincronización con CRM",
  "tags": [
    "demobot",
    "soporte",
    "escalamientos",
    "radicados"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "time": {
    "from": "now-6M",
    "to": "now"
  },
  "refresh": "5m",
  "panels": [
    {
      "id": 1,
      "title": "Radicados en el rango",
      "type": "stat",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "PCC52D03280B7034C"
      },
      "targets": [
        {
          "rawSql": "SELECT count(*) AS value FROM radicados WHERE $__timeFilter(creado_en);",
          "format": "table",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "PCC52D03280B7034C"
          }
        }
      ],
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        }
      }
    },
    {
      "id": 2,
      "title": "Resueltos",
      "type": "stat",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "PCC52D03280B7034C"
      },
      "targets": [
        {
          "rawSql": "SELECT count(*) AS value FROM radicados WHERE $__timeFilter(creado_en) AND estado = 'resuelto';",
          "format": "table",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "PCC52D03280B7034C"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "green"
          }
        }
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 0
      }
    },
    {
      "id": 3,
      "title": "Abiertos (backlog)",
      "type": "stat",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "PCC52D03280B7034C"
      },
      "targets": [
        {
          "rawSql": "SELECT count(*) AS value FROM radicados WHERE $__timeFilter(creado_en) AND estado <> 'resuelto';",
          "format": "table",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "PCC52D03280B7034C"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "orange"
          }
        }
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 0
      }
    },
    {
      "id": 4,
      "title": "Tiempo medio de resolución (h)",
      "type": "stat",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "PCC52D03280B7034C"
      },
      "targets": [
        {
          "rawSql": "SELECT round(avg(EXTRACT(EPOCH FROM (resuelto_en - creado_en)) / 3600.0)::numeric, 1) AS value FROM radicados WHERE $__timeFilter(creado_en) AND resuelto_en IS NOT NULL;",
          "format": "table",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "PCC52D03280B7034C"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "h",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 4
              },
              {
                "color": "red",
                "value": 12
              }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 0
      }
    },
    {
      "id": 5,
      "title": "Radicados creados vs resueltos por día",
      "type": "timeseries",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "PCC52D03280B7034C"
      },
      "targets": [
        {
          "rawSql": "SELECT date_trunc('day', creado_en) AS time, count(*) AS \"Creados\" FROM radicados WHERE $__timeFilter(creado_en) GROUP BY 1 ORDER BY 1;",
          "format": "time_series",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "PCC52D03280B7034C"
          }
        },
        {
          "rawSql": "SELECT date_trunc('day', resuelto_en) AS time, count(*) AS \"Resueltos\" FROM radicados WHERE resuelto_en IS NOT NULL AND $__timeFilter(resuelto_en) GROUP BY 1 ORDER BY 1;",
          "format": "time_series",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "PCC52D03280B7034C"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10
          }
        }
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 4
      }
    },
    {
      "id": 6,
      "title": "Radicados por estado",
      "type": "piechart",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "PCC52D03280B7034C"
      },
      "targets": [
        {
          "rawSql": "SELECT count(*) AS \"value\", estado AS \"metric\" FROM radicados WHERE $__timeFilter(creado_en) GROUP BY estado;",
          "format": "table",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "PCC52D03280B7034C"
          }
        }
      ],
      "options": {
        "reduceOptions": {
          "values": true,
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 12,
        "y": 4
      }
    },
    {
      "id": 7,
      "title": "Radicados por área",
      "type": "piechart",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "PCC52D03280B7034C"
      },
      "targets": [
        {
          "rawSql": "SELECT count(*) AS \"value\", a.nombre AS \"metric\" FROM radicados r JOIN areas a ON a.id = r.area_id WHERE $__timeFilter(r.creado_en) GROUP BY a.nombre;",
          "format": "table",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "PCC52D03280B7034C"
          }
        }
      ],
      "options": {
        "reduceOptions": {
          "values": true,
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 18,
        "y": 4
      }
    },
    {
      "id": 8,
      "title": "Distribución tiempo de resolución (percentiles, h)",
      "type": "bargauge",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "PCC52D03280B7034C"
      },
      "targets": [
        {
          "rawSql": "SELECT round((percentile_cont(0.5) WITHIN GROUP (ORDER BY EXTRACT(EPOCH FROM (resuelto_en - creado_en)) / 3600.0))::numeric, 1) AS \"P50\", round((percentile_cont(0.9) WITHIN GROUP (ORDER BY EXTRACT(EPOCH FROM (resuelto_en - creado_en)) / 3600.0))::numeric, 1) AS \"P90\", round((percentile_cont(0.95) WITHIN GROUP (ORDER BY EXTRACT(EPOCH FROM (resuelto_en - creado_en)) / 3600.0))::numeric, 1) AS \"P95\" FROM radicados WHERE $__timeFilter(creado_en) AND resuelto_en IS NOT NULL;",
          "format": "table",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "PCC52D03280B7034C"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "h"
        }
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "reduceOptions": {
          "values": true,
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 12
      }
    },
    {
      "id": 9,
      "title": "Tiempo de espera en cola (percentiles, seg)",
      "type": "bargauge",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "PCC52D03280B7034C"
      },
      "targets": [
        {
          "rawSql": "SELECT round((percentile_cont(0.5) WITHIN GROUP (ORDER BY duracion_espera_seg))::numeric, 0) AS \"P50\", round((percentile_cont(0.95) WITHIN GROUP (ORDER BY duracion_espera_seg))::numeric, 0) AS \"P95\" FROM conversaciones WHERE $__timeFilter(creado_en) AND duracion_espera_seg IS NOT NULL;",
          "format": "table",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "PCC52D03280B7034C"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "reduceOptions": {
          "values": true,
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 12
      }
    },
    {
      "id": 10,
      "title": "Modo de escalamiento",
      "type": "piechart",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "PCC52D03280B7034C"
      },
      "targets": [
        {
          "rawSql": "SELECT count(*) AS \"value\", coalesce(modo, 'sin_modo') AS \"metric\" FROM radicados WHERE $__timeFilter(creado_en) GROUP BY modo;",
          "format": "table",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "PCC52D03280B7034C"
          }
        }
      ],
      "options": {
        "reduceOptions": {
          "values": true,
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 12
      }
    },
    {
      "id": 11,
      "title": "Carga por agente (radicados atendidos)",
      "type": "barchart",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "PCC52D03280B7034C"
      },
      "targets": [
        {
          "rawSql": "SELECT ag.nombre AS \"metric\", count(*) AS \"value\" FROM radicados r JOIN agentes ag ON ag.id = r.agente_id WHERE $__timeFilter(r.creado_en) GROUP BY ag.nombre ORDER BY 2 DESC;",
          "format": "table",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "PCC52D03280B7034C"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "orientation": "horizontal"
          }
        }
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 20
      }
    },
    {
      "id": 12,
      "title": "Motivo de cierre de conversaciones",
      "type": "piechart",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "PCC52D03280B7034C"
      },
      "targets": [
        {
          "rawSql": "SELECT count(*) AS \"value\", coalesce(motivo_cierre, 'abierta') AS \"metric\" FROM conversaciones WHERE $__timeFilter(creado_en) GROUP BY motivo_cierre;",
          "format": "table",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "PCC52D03280B7034C"
          }
        }
      ],
      "options": {
        "reduceOptions": {
          "values": true,
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 12,
        "y": 20
      }
    },
    {
      "id": 13,
      "title": "% radicados sin sincronizar CRM",
      "type": "stat",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "PCC52D03280B7034C"
      },
      "targets": [
        {
          "rawSql": "SELECT round(100.0*count(*) FILTER (WHERE crm_case_id IS NULL)/NULLIF(count(*),0),1) AS value FROM radicados WHERE $__timeFilter(creado_en);",
          "format": "table",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "PCC52D03280B7034C"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 10
              },
              {
                "color": "red",
                "value": 25
              }
            ]
          },
          "unit": "percent"
        }
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 18,
        "y": 20
      }
    },
    {
      "id": 14,
      "title": "Backlog abierto (radicados sin resolver)",
      "type": "table",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "PCC52D03280B7034C"
      },
      "targets": [
        {
          "rawSql": "SELECT r.codigo, a.nombre AS area, ag.nombre AS agente, r.estado, r.resumen, round(EXTRACT(EPOCH FROM (now() - r.creado_en)) / 3600.0)::int AS horas_abierto FROM radicados r JOIN areas a ON a.id = r.area_id LEFT JOIN agentes ag ON ag.id = r.agente_id WHERE r.estado <> 'resuelto' ORDER BY r.creado_en ASC LIMIT 100;",
          "format": "table",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "PCC52D03280B7034C"
          }
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 28
      }
    }
  ]
