{
  "title": "DemoBot Comercial y Ventas",
  "description": "Leads, clientes, ofertas y perfil de empresas atendidas",
  "tags": [
    "demobot",
    "comercial",
    "ventas",
    "leads"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "time": {
    "from": "now-6M",
    "to": "now"
  },
  "refresh": "5m",
  "panels": [
    {
      "id": 1,
      "title": "Contactos totales",
      "type": "stat",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "PCC52D03280B7034C"
      },
      "targets": [
        {
          "rawSql": "SELECT count(*) AS value FROM contactos WHERE $__timeFilter(creado_en);",
          "format": "table",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "PCC52D03280B7034C"
          }
        }
      ],
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        }
      }
    },
    {
      "id": 2,
      "title": "Leads",
      "type": "stat",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "PCC52D03280B7034C"
      },
      "targets": [
        {
          "rawSql": "SELECT count(*) AS value FROM clientes WHERE $__timeFilter(creado_en) AND tipo = 'lead';",
          "format": "table",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "PCC52D03280B7034C"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "yellow"
          }
        }
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 0
      }
    },
    {
      "id": 3,
      "title": "Clientes",
      "type": "stat",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "PCC52D03280B7034C"
      },
      "targets": [
        {
          "rawSql": "SELECT count(*) AS value FROM clientes WHERE $__timeFilter(creado_en) AND tipo = 'cliente';",
          "format": "table",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "PCC52D03280B7034C"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "green"
          }
        }
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 0
      }
    },
    {
      "id": 4,
      "title": "Tasa de conversión a cliente (%)",
      "type": "stat",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "PCC52D03280B7034C"
      },
      "targets": [
        {
          "rawSql": "SELECT round(100.0 * count(*) FILTER (WHERE tipo='cliente') / NULLIF(count(*),0), 1) AS value FROM clientes WHERE $__timeFilter(creado_en);",
          "format": "table",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "PCC52D03280B7034C"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        }
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 0
      }
    },
    {
      "id": 5,
      "title": "Nuevos leads/clientes por día",
      "type": "timeseries",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "PCC52D03280B7034C"
      },
      "targets": [
        {
          "rawSql": "SELECT date_trunc('day', creado_en) AS time, count(*) FILTER (WHERE tipo='lead') AS \"Leads\", count(*) FILTER (WHERE tipo='cliente') AS \"Clientes\" FROM clientes WHERE $__timeFilter(creado_en) GROUP BY 1 ORDER BY 1;",
          "format": "time_series",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "PCC52D03280B7034C"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "stacking": {
              "mode": "normal"
            }
          }
        }
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 4
      }
    },
    {
      "id": 6,
      "title": "Distribución Leads vs Clientes",
      "type": "piechart",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "PCC52D03280B7034C"
      },
      "targets": [
        {
          "rawSql": "SELECT count(*) AS \"value\", tipo AS \"metric\" FROM clientes WHERE $__timeFilter(creado_en) GROUP BY tipo;",
          "format": "table",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "PCC52D03280B7034C"
          }
        }
      ],
      "options": {
        "reduceOptions": {
          "values": true,
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 12,
        "y": 4
      }
    },
    {
      "id": 7,
      "title": "Solicitudes por tipo",
      "type": "piechart",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "PCC52D03280B7034C"
      },
      "targets": [
        {
          "rawSql": "SELECT count(*) AS \"value\", coalesce(tipo_solicitud,'sin_tipo') AS \"metric\" FROM conversaciones WHERE $__timeFilter(creado_en) GROUP BY tipo_solicitud;",
          "format": "table",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "PCC52D03280B7034C"
          }
        }
      ],
      "options": {
        "reduceOptions": {
          "values": true,
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 18,
        "y": 4
      }
    },
    {
      "id": 8,
      "title": "Clientes por sector",
      "type": "barchart",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "PCC52D03280B7034C"
      },
      "targets": [
        {
          "rawSql": "SELECT sector_empresa AS \"metric\", count(*) AS \"value\" FROM clientes WHERE $__timeFilter(creado_en) AND sector_empresa IS NOT NULL GROUP BY sector_empresa ORDER BY 2 DESC;",
          "format": "table",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "PCC52D03280B7034C"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "orientation": "horizontal"
          }
        }
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 12
      }
    },
    {
      "id": 9,
      "title": "Tamaño de empresa (empleados)",
      "type": "piechart",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "PCC52D03280B7034C"
      },
      "targets": [
        {
          "rawSql": "SELECT count(*) AS \"value\", empleados_empresa AS \"metric\" FROM clientes WHERE $__timeFilter(creado_en) AND empleados_empresa IS NOT NULL GROUP BY empleados_empresa;",
          "format": "table",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "PCC52D03280B7034C"
          }
        }
      ],
      "options": {
        "reduceOptions": {
          "values": true,
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 12
      }
    },
    {
      "id": 10,
      "title": "Catálogo de módulos (precio mensual COP)",
      "type": "table",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "PCC52D03280B7034C"
      },
      "targets": [
        {
          "rawSql": "SELECT nombre, precio_mensual_cop FROM modulos ORDER BY precio_mensual_cop DESC;",
          "format": "table",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "PCC52D03280B7034C"
          }
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 12
      }
    },
    {
      "id": 11,
      "title": "Ofertas activas hoy",
      "type": "table",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "PCC52D03280B7034C"
      },
      "targets": [
        {
          "rawSql": "SELECT o.id, m.nombre AS modulo, o.descuento_pct, o.fecha_inicio, o.fecha_fin FROM ofertas o JOIN modulos m ON m.id = o.modulo_id WHERE o.activo AND current_date BETWEEN o.fecha_inicio AND o.fecha_fin ORDER BY o.descuento_pct DESC;",
          "format": "table",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "PCC52D03280B7034C"
          }
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 20
      }
    }
  ]
}