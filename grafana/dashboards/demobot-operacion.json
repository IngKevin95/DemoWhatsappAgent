{
  "title": "DemoBot Operación y Agentes",
  "description": "Capacidad, carga y cobertura del equipo de agentes",
  "tags": [
    "demobot",
    "operacion",
    "agentes"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "time": {
    "from": "now-6M",
    "to": "now"
  },
  "refresh": "5m",
  "panels": [
    {
      "id": 1,
      "title": "Agentes activos",
      "type": "stat",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "PCC52D03280B7034C"
      },
      "targets": [
        {
          "rawSql": "SELECT count(*) AS value FROM agentes WHERE activo;",
          "format": "table",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "PCC52D03280B7034C"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "green"
          }
        }
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      }
    },
    {
      "id": 2,
      "title": "Ocupados ahora (atendiendo)",
      "type": "stat",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "PCC52D03280B7034C"
      },
      "targets": [
        {
          "rawSql": "SELECT count(DISTINCT atendido_por) AS value FROM contactos WHERE atendido_por IS NOT NULL;",
          "format": "table",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "PCC52D03280B7034C"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        }
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 0
      }
    },
    {
      "id": 3,
      "title": "Radicados en backlog",
      "type": "stat",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "PCC52D03280B7034C"
      },
      "targets": [
        {
          "rawSql": "SELECT count(*) AS value FROM radicados WHERE estado <> 'resuelto';",
          "format": "table",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "PCC52D03280B7034C"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 10
              },
              {
                "color": "red",
                "value": 30
              }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 0
      }
    },
    {
      "id": 4,
      "title": "Radicados/agente (promedio, rango)",
      "type": "stat",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "PCC52D03280B7034C"
      },
      "targets": [
        {
          "rawSql": "SELECT round(count(*)::numeric / NULLIF((SELECT count(*) FROM agentes WHERE activo),0), 1) AS value FROM radicados WHERE $__timeFilter(creado_en) AND agente_id IS NOT NULL;",
          "format": "table",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "PCC52D03280B7034C"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        }
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 0
      }
    },
    {
      "id": 5,
      "title": "Agentes por área",
      "type": "barchart",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "PCC52D03280B7034C"
      },
      "targets": [
        {
          "rawSql": "SELECT 'Agentes activos' AS metric, count(*) FILTER (WHERE a.nombre='comercial' AND ag.activo) AS \"Comercial\", count(*) FILTER (WHERE a.nombre='soporte' AND ag.activo) AS \"Soporte\" FROM agentes ag JOIN areas a ON a.id = ag.area_id;",
          "format": "table",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "PCC52D03280B7034C"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 90
          },
          "color": {
            "mode": "palette-classic"
          }
        }
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 4
      },
      "options": {
        "orientation": "horizontal",
        "showValue": "always"
      }
    },
    {
      "id": 6,
      "title": "Carga por agente (radicados atendidos)",
      "type": "barchart",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "PCC52D03280B7034C"
      },
      "targets": [
        {
          "rawSql": "SELECT ag.nombre AS \"metric\", count(*) AS \"value\" FROM radicados r JOIN agentes ag ON ag.id = r.agente_id WHERE $__timeFilter(r.creado_en) GROUP BY ag.nombre ORDER BY 2 DESC;",
          "format": "table",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "PCC52D03280B7034C"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 90
          },
          "color": {
            "mode": "continuous-BlPu"
          }
        }
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 4
      },
      "options": {
        "orientation": "vertical",
        "xTickLabelRotation": -45,
        "showValue": "auto"
      }
    },
    {
      "id": 7,
      "title": "Tiempo medio de resolución por agente (h)",
      "type": "barchart",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "PCC52D03280B7034C"
      },
      "targets": [
        {
          "rawSql": "SELECT ag.nombre AS \"metric\", round(avg(EXTRACT(EPOCH FROM (r.resuelto_en - r.creado_en))/3600.0)::numeric,1) AS \"value\" FROM radicados r JOIN agentes ag ON ag.id = r.agente_id WHERE $__timeFilter(r.creado_en) AND r.resuelto_en IS NOT NULL GROUP BY ag.nombre ORDER BY 2 DESC;",
          "format": "table",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "PCC52D03280B7034C"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "h",
          "custom": {
            "fillOpacity": 90
          },
          "color": {
            "mode": "continuous-YlRd"
          }
        }
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 4
      },
      "options": {
        "orientation": "vertical",
        "xTickLabelRotation": -45,
        "showValue": "auto"
      }
    },
    {
      "id": 8,
      "title": "Cobertura horaria y estado de agentes",
      "type": "table",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "PCC52D03280B7034C"
      },
      "targets": [
        {
          "rawSql": "SELECT ag.nombre, a.nombre AS area, ag.hora_inicio, ag.hora_fin, ag.telefono, CASE WHEN ag.activo THEN 'activo' ELSE 'inactivo' END AS estado FROM agentes ag JOIN areas a ON a.id = ag.area_id ORDER BY a.nombre, ag.nombre;",
          "format": "table",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "PCC52D03280B7034C"
          }
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 12
      }
    }
  ]
}